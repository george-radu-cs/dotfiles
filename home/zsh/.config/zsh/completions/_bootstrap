#compdef bootstrap.sh -p */bootstrap.sh
# Completion for the dotfiles bootstrap script: ./bootstrap.sh <command> [options]

local -a commands steps backups
commands=(
  'install:run every setup step in order'
  'packages:system packages (Homebrew / pacman / dnf / apt) and mise'
  'link:symlink the repo configs into $HOME'
  'toolchains:mise tools and Rust'
  'docker:Docker Engine (Linux) or check Docker Desktop (macOS)'
  'fonts:JetBrainsMono Nerd Font'
  'shell:login shell, zsh/tmux/Neovim plugins, theme'
  'backup:copy the current config, change nothing'
  'clean:move leftovers of an old setup into a backup'
  'backups:list backups'
  'restore:undo the newest or a named backup'
  'check:report missing or broken links'
  'unlink:remove every link this repo created'
  'help:show help for a command'
)
steps=(packages link toolchains docker fonts shell)

_arguments -C \
  '(-n --dry-run)'{-n,--dry-run}'[print what would happen, change nothing]' \
  '--extra[also install Brewfile.extra (macOS)]' \
  '(-h --help)'{-h,--help}'[show help]' \
  '1: :->command' \
  '*:: :->args' && return

case $state in
  command)
    _describe -t commands 'bootstrap command' commands ;;
  args)
    case $words[1] in
      help)
        _describe -t commands 'command' commands ;;
      restore)
        backups=(${HOME}/.dotfiles-backup/*(N/:t))
        _describe -t backups 'backup' backups ;;
      packages|link|toolchains|docker|fonts|shell)
        _describe -t steps 'step' steps ;;
    esac
    _arguments \
      '(-n --dry-run)'{-n,--dry-run}'[print what would happen, change nothing]' \
      '--extra[also install Brewfile.extra (macOS)]' \
      '(-h --help)'{-h,--help}'[show help for this command]' ;;
esac
