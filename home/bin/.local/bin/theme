#!/usr/bin/env bash
# theme — switch the colour theme everywhere.
#
#   theme              show the current theme and the available ones
#   theme <name>       apply <name> (e.g. gruvbox, kanagawa-wave)
#
# Palettes live in $DOTFILES/themes/<name>.sh. Applying one writes small files
# to $XDG_STATE_HOME/dotfiles/theme/ that each tool reads:
#   name, theme.json  → WezTerm (hot-reloads), Neovim (on focus / next start)
#   tmux.conf         → tmux status bar and pane colours (reloaded now)
#   shell.zsh         → BAT_THEME (bat, delta), fzf colours (new shells)
#   btop              → ~/.config/btop/themes/dotfiles.theme
# Starship and lazygit use ANSI colours, so they follow the terminal palette.
set -euo pipefail

resolve() {
  local p=$1
  while [[ -L $p ]]; do
    local l; l=$(readlink "$p")
    [[ $l == /* ]] && p=$l || p="$(dirname "$p")/$l"
  done
  (cd "$(dirname "$p")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$p")")
}
DOTFILES="${DOTFILES:-$(dirname "$(resolve "${BASH_SOURCE[0]}")")/../../../..}"
DOTFILES=$(cd "$DOTFILES" && pwd -P)
THEMES="$DOTFILES/themes"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"

list() { for f in "$THEMES"/*.sh; do basename "$f" .sh; done; }

if [[ $# -eq 0 || $1 == -l || $1 == --list ]]; then
  current=$(cat "$STATE/name" 2>/dev/null || echo "gruvbox (default)")
  echo "current: $current"
  echo "available:"; list | sed 's/^/  /'
  exit 0
fi
[[ $1 == -h || $1 == --help ]] && { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

name=$1
palette="$THEMES/$name.sh"
[[ -f $palette ]] || { echo "unknown theme: $name (try: $(list | tr '\n' ' '))" >&2; exit 1; }
# shellcheck source=/dev/null
source "$palette"

mkdir -p "$STATE" "$CONFIG/btop/themes"

# Write to a temp file and rename, so readers (WezTerm, nvim) never see a half file.
put() { local f=$1; cat >"$f.tmp" && mv "$f.tmp" "$f"; }

put "$STATE/theme.json" <<EOF
{
  "name": "$name",
  "appearance": "$APPEARANCE",
  "wezterm": "$WEZTERM_SCHEME",
  "nvim": "$NVIM_COLORSCHEME"
}
EOF

put "$STATE/tmux.conf" <<EOF
# generated by \`theme $name\`
set -g @thm_bg "$BG"
set -g @thm_bg1 "$BG1"
set -g @thm_bg2 "$BG2"
set -g @thm_fg "$FG"
set -g @thm_dim "$GRAY"
set -g @thm_accent "$BLUE"
set -g @thm_alert "$ORANGE"
set -g @thm_ok "$GREEN"
set -g @thm_warn "$YELLOW"
EOF

fzf="--color=bg+:$BG1,bg:-1,gutter:-1,border:$BG2,fg:$FG,fg+:$FG,hl:$YELLOW,hl+:$YELLOW"
fzf+=",info:$CYAN,prompt:$BLUE,pointer:$RED,marker:$GREEN,spinner:$ORANGE,header:$GRAY"
put "$STATE/shell.zsh" <<EOF
# generated by \`theme $name\`
export DOTFILES_THEME="$name"
export BAT_THEME="$BAT_THEME"
export DOTFILES_FZF_COLORS="$fzf"
EOF

put "$CONFIG/btop/themes/dotfiles.theme" <<EOF
# generated by \`theme $name\`
theme[main_bg]="$BG"
theme[main_fg]="$FG"
theme[title]="$FG"
theme[hi_fg]="$BLUE"
theme[selected_bg]="$BG2"
theme[selected_fg]="$FG"
theme[inactive_fg]="$GRAY"
theme[graph_text]="$FG_DIM"
theme[meter_bg]="$BG1"
theme[proc_misc]="$CYAN"
theme[cpu_box]="$BLUE"
theme[mem_box]="$GREEN"
theme[net_box]="$MAGENTA"
theme[proc_box]="$ORANGE"
theme[div_line]="$BG2"
theme[temp_start]="$GREEN"
theme[temp_mid]="$YELLOW"
theme[temp_end]="$RED"
theme[cpu_start]="$CYAN"
theme[cpu_mid]="$BLUE"
theme[cpu_end]="$MAGENTA"
theme[free_start]="$GREEN"
theme[free_mid]="$GREEN"
theme[free_end]="$CYAN"
theme[cached_start]="$BLUE"
theme[cached_mid]="$BLUE"
theme[cached_end]="$CYAN"
theme[available_start]="$YELLOW"
theme[available_mid]="$YELLOW"
theme[available_end]="$ORANGE"
theme[used_start]="$ORANGE"
theme[used_mid]="$RED"
theme[used_end]="$RED"
theme[download_start]="$BLUE"
theme[download_mid]="$CYAN"
theme[download_end]="$GREEN"
theme[upload_start]="$MAGENTA"
theme[upload_mid]="$ORANGE"
theme[upload_end]="$RED"
theme[process_start]="$GREEN"
theme[process_mid]="$YELLOW"
theme[process_end]="$RED"
EOF
btop_conf="$CONFIG/btop/btop.conf"
if [[ -f $btop_conf ]] && grep -q '^color_theme' "$btop_conf"; then
  sed -i.bak 's|^color_theme = .*|color_theme = "dotfiles"|' "$btop_conf" && rm -f "$btop_conf.bak"
else
  echo 'color_theme = "dotfiles"' >>"$btop_conf"
fi

# name last: WezTerm watches this file and reloads when it changes.
echo "$name" | put "$STATE/name"

# Live-reload what we can.
if command -v tmux >/dev/null && tmux info >/dev/null 2>&1; then
  tmux source-file "$CONFIG/tmux/tmux.conf" >/dev/null 2>&1 || true
fi

echo "theme → $name  (WezTerm, tmux, btop now; nvim on focus; bat/fzf in new shells — or: exec zsh)"
