# macOS core packages: `brew bundle --file packages/Brewfile`
# Languages and CLI tools (neovim, fzf, go, …) come from mise, the same on every
# OS (home/mise/.config/mise/config.toml). This file keeps the rest.
# Optional/occasional tools live in Brewfile.extra (bootstrap --extra).

# --- shell & terminal ------------------------------------------------------
brew "zsh"
brew "stow"
# git itself is Apple's (Xcode Command Line Tools); only the LFS extension comes from brew
brew "git-lfs"
brew "gnupg"
brew "coreutils"
brew "curl"
brew "wget"
brew "tmux"
brew "vim"
brew "mise"
brew "btop"
brew "tree"
brew "luarocks"          # some LazyVim plugins build rocks

# --- languages -----------------------------------------------------------------
# Rust comes from the official rustup installer (lib/toolchains.sh), not brew.
brew "lua"
brew "luajit"            # what Neovim embeds

# --- C / C++ (clang itself comes from the Xcode Command Line Tools) ---------
brew "llvm"              # clangd, clang-format, clang-tidy, lldb
brew "cmake"
brew "ninja"
brew "ccache"
brew "cppcheck"
brew "pkgconf"

# --- LaTeX: official TeX Live (MacTeX) + Skim viewer with SyncTeX ------------
cask "mactex"            # TeX Live: pdflatex/lualatex/xelatex, latexmk, biber, chktex, latexindent, tlmgr
cask "skim"              # PDF viewer; vimtex jumps source ⇄ PDF (SyncTeX)
brew "cpanminus"         # installs latexindent's Perl modules (see lib/latex.sh)

# --- GUI ---------------------------------------------------------------------
cask "wezterm"
cask "font-jetbrains-mono-nerd-font"
cask "font-jetbrains-mono"            # plain variant, used by VS Code
cask "docker-desktop"
cask "alfred"
cask "obsidian"

# --- Mac App Store (needs you signed in to the App Store; `mas` is the CLI) ---
brew "mas"
mas "Bitwarden", id: 1352778147   # App Store build: includes the Safari extension
