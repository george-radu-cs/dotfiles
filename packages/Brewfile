# macOS core packages: `brew bundle --file packages/Brewfile`
# Language runtimes (java, node, bun, go, python) come from mise, not brew.
# Optional/occasional tools live in Brewfile.extra (bootstrap --extra).

# --- shell & terminal ------------------------------------------------------
brew "zsh"
brew "stow"
# git itself is Apple's (Xcode Command Line Tools); only the LFS extension comes from brew
brew "git-lfs"
brew "gnupg"
brew "coreutils"
brew "curl"
brew "wget"
brew "tmux"
brew "neovim"
brew "vim"
brew "starship"
brew "mise"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "zoxide"
brew "git-delta"
brew "lazygit"
brew "gh"
brew "jq"
brew "yazi"
brew "tealdeer"
brew "btop"
brew "fastfetch"
brew "tree"
brew "tree-sitter-cli"   # nvim-treesitter compiles parsers with it
brew "luarocks"          # some LazyVim plugins build rocks
brew "shellcheck"        # lint shell scripts (bootstrap, lib/)
brew "stylua"            # format Lua (nvim config)

# --- languages -----------------------------------------------------------------
# java/node/bun/python come from mise (home/mise/.config/mise/config.toml).
# Rust comes from the official rustup installer (lib/toolchains.sh), not brew.
brew "go"
brew "typescript"        # tsc (pulls brew node as a dependency; mise's node wins on PATH)
brew "lua"
brew "luajit"            # what Neovim embeds

# --- C / C++ (clang itself comes from the Xcode Command Line Tools) ---------
brew "llvm"              # clangd, clang-format, clang-tidy, lldb
brew "cmake"
brew "ninja"
brew "ccache"
brew "cppcheck"
brew "pkgconf"

# --- GUI ---------------------------------------------------------------------
cask "wezterm"
cask "font-jetbrains-mono-nerd-font"
cask "font-jetbrains-mono"            # plain variant, used by VS Code
cask "docker-desktop"
cask "alfred"
cask "obsidian"

# --- Mac App Store (needs you signed in to the App Store; `mas` is the CLI) ---
brew "mas"
mas "Bitwarden", id: 1352778147   # App Store build: includes the Safari extension
